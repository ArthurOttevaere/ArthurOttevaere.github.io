{
  "name": "arthurottevaere-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal portfolio site. Static — served by GitHub Pages. `npm run build` compiles src/*.jsx into dist/app.js (commit it). data.js is loaded directly and needs no build.",
  "scripts": {
    "build": "node tools/build.mjs",
    "watch": "node --watch-path=src tools/build.mjs",
    "images": "node tools/optimize-images.mjs",
    "og": "node tools/generate-og.mjs",
    "icons": "node tools/generate-icons.mjs",
    "geo": "node tools/vendor-geo.mjs"
  },
  "devDependencies": {
    "d3-array": "^3.2.4",
    "d3-geo": "^3.1.1",
    "esbuild": "^0.28.1",
    "playwright": "^1.61.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  }
}
